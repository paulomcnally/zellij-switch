#!/usr/bin/env bash
#
# zellij-switch - switch between Zellij keybinding variants for Ctrl+P
#
# See README.md for full documentation.
#
set -euo pipefail

VERSION="1.0.0"

CONFIG_DIR="${ZELLIJ_CONFIG_DIR:-$HOME/.config/zellij}"
CONFIG_FILE="$CONFIG_DIR/config.kdl"
VARIANTS_DIR="$CONFIG_DIR/variants"
ACTUAL="$VARIANTS_DIR/actual.kdl"
VARIANT_A="$VARIANTS_DIR/a.kdl"
VARIANT_B="$VARIANTS_DIR/b.kdl"

SED_BIN="${SED_BIN:-sed}"

SCRIPT_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# --- helpers ---------------------------------------------------------------

die() {
    printf 'zellij-switch: error: %s\n' "$*" >&2
    exit 1
}

info() {
    printf 'zellij-switch: %s\n' "$*"
}

warn() {
    printf 'zellij-switch: warning: %s\n' "$*" >&2
}

require_cmd() {
    local name="$1"
    local msg="${2:-required command '$name' not found}"
    if ! command -v "$name" >/dev/null 2>&1; then
        die "$msg"
    fi
}

# --- environment validation -------------------------------------------------

# Check that we are on a supported platform and that every binary and file we
# depend on is actually present, so the script fails with a clear message
# instead of a cryptic one if it is run in an unsupported environment.
check_env() {
    case "$(uname -s)" in
        Linux | Darwin) ;;
        *)
            die "unsupported OS '$(uname -s)'; zellij-switch supports Linux and macOS only"
            ;;
    esac

    require_cmd zellij "zellij is not installed or not in your PATH"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        die "no Zellij config found at $CONFIG_FILE (run 'zellij setup' first)"
    fi

    if "$SED_BIN" --version 2>/dev/null | grep -qi 'GNU sed'; then
        :
    elif command -v gsed >/dev/null 2>&1; then
        SED_BIN="gsed"
    else
        die "GNU sed is required (on macOS install coreutils with: brew install coreutils)"
    fi
}

# --- variant management -----------------------------------------------------

# The Ctrl+P binding is replaced by the variants. It must be a single-line
# `bind "Ctrl p" { ... }` statement, which is the case in the default Zellij
# config and in configs generated by `zellij setup`.
CTRL_P_PATTERN='^([[:space:]]*)bind[[:space:]]+"Ctrl p"[[:space:]]*\{.*\}[[:space:]]*$'

patch_ctrl_p() {
    local src="$1"
    local dst="$2"
    local mode="$3"

    # The Ctrl+P binding must be a single-line `bind "Ctrl p" { ... }`
    # statement. If it is not (missing, or written over multiple lines), bail
    # out with a clear message instead of silently doing nothing.
    if ! grep -Eq "$CTRL_P_PATTERN" "$src"; then
        return 1
    fi

    if [[ "$mode" == "a" ]]; then
        "$SED_BIN" -E "s|$CTRL_P_PATTERN|\1bind \"Ctrl p\" { SwitchFocus; }|" "$src" > "$dst"
    else
        "$SED_BIN" -E "s|$CTRL_P_PATTERN|\1bind \"Ctrl p\" {\n\1    LaunchOrFocusPlugin \"session-manager\" {\n\1        floating true\n\1        move_to_focused_tab true\n\1    }\n\1}|" "$src" > "$dst"
    fi
}

ensure_baseline() {
    mkdir -p "$VARIANTS_DIR"
    if [[ ! -f "$ACTUAL" ]]; then
        cp "$CONFIG_FILE" "$ACTUAL"
        info "backup of current config saved to $ACTUAL"
    fi
}

generate_variant_a() {
    if ! patch_ctrl_p "$ACTUAL" "$VARIANT_A" a; then
        die "unable to patch variant 'a': no single-line 'bind \"Ctrl p\"' found in $ACTUAL"
    fi
}

generate_variant_b() {
    if ! patch_ctrl_p "$ACTUAL" "$VARIANT_B" b; then
        die "unable to patch variant 'b': no single-line 'bind \"Ctrl p\"' found in $ACTUAL"
    fi
}

variant_description() {
    case "$1" in
        actual) echo "Ctrl+P creates a new pane (original behavior)" ;;
        a) echo "Ctrl+P opens the pane picker (SwitchFocus)" ;;
        b) echo "Ctrl+P opens the Session Manager sidebar" ;;
        *) echo "unknown variant" ;;
    esac
}

# --- commands ----------------------------------------------------------------

switch_to() {
    local target="$1"

    check_env
    ensure_baseline

    case "$target" in
        actual) cp "$ACTUAL" "$CONFIG_FILE" ;;
        a)
            generate_variant_a
            cp "$VARIANT_A" "$CONFIG_FILE"
            ;;
        b)
            generate_variant_b
            cp "$VARIANT_B" "$CONFIG_FILE"
            ;;
        *) die "unknown variant '$target'" ;;
    esac

    info "switched to variant '$target' ($(variant_description "$target"))"
    info "restart Zellij (or start a new session) for the new keybindings to take effect"
}

status() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        info "no config file at $CONFIG_FILE"
        return 1
    fi

    if [[ -f "$ACTUAL" ]] && cmp -s "$CONFIG_FILE" "$ACTUAL"; then
        echo "active variant: actual (Ctrl+P creates a new pane)"
    elif [[ -f "$VARIANT_A" ]] && cmp -s "$CONFIG_FILE" "$VARIANT_A"; then
        echo "active variant: a (pane picker)"
    elif [[ -f "$VARIANT_B" ]] && cmp -s "$CONFIG_FILE" "$VARIANT_B"; then
        echo "active variant: b (session manager)"
    else
        echo "active variant: unknown (config has drifted from every known variant)"
        return 1
    fi
}

snapshot() {
    check_env
    ensure_baseline
    cp "$CONFIG_FILE" "$ACTUAL"
    if ! patch_ctrl_p "$ACTUAL" "$VARIANT_A" a; then
        warn "could not generate variant 'a' (no single-line 'bind \"Ctrl p\"' binding)"
    fi
    if ! patch_ctrl_p "$ACTUAL" "$VARIANT_B" b; then
        warn "could not generate variant 'b' (no single-line 'bind \"Ctrl p\"' binding)"
    fi
    info "snapshot saved: current config is now the 'actual' baseline; variants a/b regenerated"
}

install_script() {
    local dest="${1:-${HOME}/.local/bin/zellij-switch}"
    mkdir -p "$(dirname "$dest")"
    cp "$SCRIPT_SOURCE" "$dest"
    chmod +x "$dest"
    info "installed to $dest"
}

usage() {
    cat <<EOF
zellij-switch $VERSION - switch between Zellij keybinding variants for Ctrl+P

Usage:
  zellij-switch <command>

Commands:
  status              Show which variant is currently active
  actual              Restore the original config (Ctrl+P creates a new pane)
  a                   Switch to variant A: Ctrl+P opens the pane picker (SwitchFocus)
  b                   Switch to variant B: Ctrl+P opens the Session Manager sidebar
  snapshot            Save the current config as the new "actual" baseline
  install [path]      Install this script to ~/.local/bin/zellij-switch (or a custom path)
  help                Show this help
  version             Show the version

Environment:
  ZELLIJ_CONFIG_DIR   Override the Zellij config directory (default: ~/.config/zellij)

See README.md for full documentation.
EOF
}

main() {
    local cmd="${1:-status}"

    case "$cmd" in
        help | --help | -h)
            usage
            ;;
        version | --version | -V)
            echo "zellij-switch $VERSION"
            ;;
        status)
            check_env
            status
            ;;
        actual | a | b)
            switch_to "$cmd"
            ;;
        snapshot)
            snapshot
            ;;
        install)
            install_script "${2:-}"
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"